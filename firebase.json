{
  "firestore": {
    "database": "production",
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/api/tochka/status",        "function": "tochkaStatus" },
      { "source": "/api/tochka/save-token",     "function": "tochkaSaveToken" },
      { "source": "/api/tochka/create-payment", "function": "tochkaCreatePayment" },
      { "source": "/api/tochka/find-payment",   "function": "tochkaFindPayment" },
      { "source": "**",                         "destination": "/index.html" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log"]
    }
  ]
}
