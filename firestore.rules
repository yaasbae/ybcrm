rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "ndtiger86@gmail.com" && request.auth.token.email_verified == true);
    }

    function accessProfilePath() {
      return /databases/$(database)/documents/crm_access_profiles/$(request.auth.uid);
    }

    function hasOrderAction(action) {
      return isAdmin() || (isAuthenticated() && (
        exists(accessProfilePath()) &&
        get(accessProfilePath()).data.active == true &&
        get(accessProfilePath()).data.orderActionsConfigured == true &&
        ('allowedOrderActions' in get(accessProfilePath()).data) &&
        get(accessProfilePath()).data.allowedOrderActions.hasAny([action])
      ));
    }

    function canUpdateOrder() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let specialFields = [
        'updatedAt', 'activityAt',
        'status', 'isShipped',
        'orderId', 'exchangeOriginalOrderId', 'exchangeAt', 'exchangeCdekStatus', 'exchangeCdekError',
        'paymentUrl', 'paymentId', 'paymentStatus', 'paymentCreatedAt', 'paymentAmount',
        'initialPaymentAmount', 'paymentProvider', 'paymentPaidAt', 'paymentAccountingVersion', 'paidAmount',
        'finalPaymentUrl', 'finalPaymentId', 'finalPaymentStatus', 'finalPaymentCreatedAt',
        'finalPaymentAmount', 'finalPaymentProvider', 'finalPaymentPaidAt',
        'cdekUuid', 'cdekNumber', 'cdekStatus', 'cdekPayload', 'cdekUpdatedAt',
        'deleted', 'deletedAt'
      ];
      return
        (changed.hasOnly(specialFields) || hasOrderAction('edit')) &&
        (!changed.hasAny(['deleted', 'deletedAt']) || hasOrderAction('delete')) &&
        (!changed.hasAny(['status']) ||
          (request.resource.data.status == 'Обмен' && hasOrderAction('exchange')) ||
          (request.resource.data.status != 'Обмен' && hasOrderAction('status'))) &&
        (!changed.hasAny(['isShipped']) || hasOrderAction('status')) &&
        (!changed.hasAny(['orderId', 'exchangeOriginalOrderId', 'exchangeAt', 'exchangeCdekStatus', 'exchangeCdekError']) || hasOrderAction('exchange')) &&
        (!changed.hasAny([
          'paymentUrl', 'paymentId', 'paymentStatus', 'paymentCreatedAt', 'paymentAmount',
          'initialPaymentAmount', 'paymentProvider', 'paymentPaidAt', 'paymentAccountingVersion', 'paidAmount',
          'finalPaymentUrl', 'finalPaymentId', 'finalPaymentStatus', 'finalPaymentCreatedAt',
          'finalPaymentAmount', 'finalPaymentProvider', 'finalPaymentPaidAt'
        ]) || hasOrderAction('payments')) &&
        (!changed.hasAny(['cdekUuid', 'cdekNumber', 'cdekStatus', 'cdekPayload', 'cdekUpdatedAt']) || hasOrderAction('cdek'));
    }

    // Products collection
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection
    match /orders/{document=**} {
      allow read: if isAuthenticated();
      allow create: if hasOrderAction('create');
      allow update: if canUpdateOrder();
      allow delete: if hasOrderAction('delete');
    }

    // New Orders collection
    match /orders_new/{document=**} {
      allow read: if isAuthenticated();
      allow create: if hasOrderAction('create');
      allow update: if canUpdateOrder();
      allow delete: if hasOrderAction('delete');
    }

    // CRM action journal: order edits, soft deletes and integration actions.
    match /audit_logs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Expenses collection
    match /expenses/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Manual links between bank operations and CRM orders are owner-only.
    match /finance_reconciliations/{document=**} {
      allow read, write: if isAdmin();
    }

    // Outsourced production journal. Signed-in production staff can add and edit entries.
    match /production_entries/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Marketing stats collection
    match /marketing_stats/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Sales goals collection
    match /sales_goals/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Handbook must be editable from the CRM UI by signed-in staff.
    match /settings/handbook {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Bot settings are saved through server API endpoints.
    match /settings/bot_config {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/bot_buttons {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/bot_manager_config {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Other settings stay admin-only because they may contain integration config.
    match /settings/storefront {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/marketingBloggers {
      allow read, write: if isAuthenticated();
    }

    match /settings/manager_sales_plan {
      allow read, write: if isAuthenticated();
    }

    match /settings/ai_config {
      allow read, write: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // AI Logs collection
    match /ai_logs/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Contacts collection
    match /contacts/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Contact history created by managers from the clients page.
    match /manager_contacts/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Current CRM user -> internal manager name binding.
    match /manager_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Manager work shifts: check-in, daily base outreach target, and payroll credit.
    match /manager_shifts/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Broadcast history and broadcast runtime data.
    match /broadcasts/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /settings/broadcast_config {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/no_telegram {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/stealth_sent {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/stealth_job {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /settings/stealth_job_data {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Telegram bot data is written by the CRM server through Admin SDK.
    match /costumes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bot_subscribers/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /bot_messages/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /tryon_usage/{document=**} {
      allow read, write: if false;
    }

    match /tryon_states/{document=**} {
      allow read, write: if false;
    }

    match /tryon_orders/{document=**} {
      allow read, write: if false;
    }

    // Dialog Knowledge Base collection
    match /dialog_knowledge_base/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // AI audit is server-only. Firebase Admin bypasses client rules.
    match /ai_agent_audit_logs/{document=**} {
      allow read, write: if false;
    }

    // References collection
    match /references/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }
  }
}
