rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "ndtiger86@gmail.com" && request.auth.token.email_verified == true);
    }

    // Products collection
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection
    match /orders/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // New Orders collection
    match /orders_new/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // CRM action journal: order edits, soft deletes and integration actions.
    match /audit_logs/{document=**} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Expenses collection
    match /expenses/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Outsourced production journal. Signed-in production staff can add and edit entries.
    match /production_entries/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Marketing stats collection
    match /marketing_stats/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Sales goals collection
    match /sales_goals/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Handbook must be editable from the CRM UI by signed-in staff.
    match /settings/handbook {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Bot settings are saved through server API endpoints.
    match /settings/bot_config {
      allow read: if true;
      allow write: if true;
    }

    match /settings/bot_buttons {
      allow read: if true;
      allow write: if true;
    }

    match /settings/bot_manager_config {
      allow read: if true;
      allow write: if true;
    }

    // Other settings stay admin-only because they may contain integration config.
    match /settings/storefront {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AI Logs collection
    match /ai_logs/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Contacts collection
    match /contacts/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Contact history created by managers from the clients page.
    match /manager_contacts/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Current CRM user -> internal manager name binding.
    match /manager_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Manager work shifts: check-in, daily base outreach target, and payroll credit.
    match /manager_shifts/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Broadcast history and broadcast runtime data.
    match /broadcasts/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /settings/broadcast_config {
      allow read: if true;
      allow write: if true;
    }

    match /settings/no_telegram {
      allow read: if true;
      allow write: if true;
    }

    match /settings/stealth_sent {
      allow read: if true;
      allow write: if true;
    }

    match /settings/stealth_job {
      allow read: if true;
      allow write: if true;
    }

    match /settings/stealth_job_data {
      allow read: if true;
      allow write: if true;
    }

    // Telegram bot data is written by the CRM server through Firebase client SDK,
    // so these collections need explicit access outside browser auth.
    match /costumes/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    match /bot_subscribers/{document=**} {
      allow read: if isAuthenticated();
      allow write: if true;
    }

    match /bot_messages/{document=**} {
      allow read: if isAuthenticated();
      allow write: if true;
      allow update: if isAuthenticated();
    }

    match /tryon_usage/{document=**} {
      allow read, write: if true;
    }

    match /tryon_states/{document=**} {
      allow read, write: if true;
    }

    match /tryon_orders/{document=**} {
      allow read, write: if true;
    }

    // Dialog Knowledge Base collection
    match /dialog_knowledge_base/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // References collection
    match /references/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }
  }
}
