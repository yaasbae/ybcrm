# Gemini API Key
GEMINI_API_KEY=

# Telegram Bot
TG_BOT_TOKEN=
# One or several chat IDs separated by comma/spaces. Send /myid to the bot to get chat_id.
MANAGER_CHAT_IDS=

# CDEK API Credentials
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_IS_TEST=true

# Default Sender City (e.g., Moscow)
CDEK_SENDER_CITY_CODE=44

# HMAC secret shared only with the storefront server runtime.
# Generate a long random value; never expose it to browser code.
STOREFRONT_SHARED_SECRET=
